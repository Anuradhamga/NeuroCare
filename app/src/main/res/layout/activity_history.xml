<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/historyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- History Content -->

    <ScrollView
        android:id="@+id/historyMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/historyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header -->

            <TextView
                android:id="@+id/historyHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEUROCARE"
                android:textColor="#C94A0C"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/historyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Session History 📊"
                android:textColor="#2B1A10"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/historySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Review your previous cognitive training sessions."
                android:textColor="#6B5B52"
                android:textSize="14sp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="25dp" />

            <!-- Summary Card -->

            <LinearLayout
                android:id="@+id/historySummaryCard"
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="23dp"
                android:background="@drawable/bg_daily_goal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR TRAINING JOURNEY"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Sessions Completed"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- Recent Sessions Heading -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="29dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/recentSessionsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Sessions"
                    android:textColor="#2B1A10"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/historyLatestLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LATEST"
                    android:textColor="#C94A0C"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_training_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />

            </LinearLayout>

            <!-- Dynamic History Cards -->

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty History -->

            <LinearLayout
                android:id="@+id/emptyHistory"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="25dp"
                android:background="@drawable/bg_training_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📭"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/emptyHistoryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No Sessions Yet"
                    android:textColor="#2B1A10"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="15dp" />

                <TextView
                    android:id="@+id/emptyHistoryDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start playing brain games to see your training history here."
                    android:textColor="#6B5B52"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="25dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bottom_navigation"
        android:padding="5dp">

        <!-- Home -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="23sp"
                android:textColor="#6B5B52" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textColor="#6B5B52" />

        </LinearLayout>

        <!-- Games -->

        <LinearLayout
            android:id="@+id/navGames"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Games"
                android:textSize="10sp"
                android:textColor="#6B5B52" />

        </LinearLayout>

        <!-- Progress -->

        <LinearLayout
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▥"
                android:textSize="23sp"
                android:textColor="#6B5B52" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progress"
                android:textSize="10sp"
                android:textColor="#6B5B52" />

        </LinearLayout>

        <!-- History Selected -->

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◷"
                android:textSize="23sp"
                android:textColor="#9A3412" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9A3412" />

        </LinearLayout>

        <!-- Profile -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="19sp"
                android:textColor="#6B5B52" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="10sp"
                android:textColor="#6B5B52" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>