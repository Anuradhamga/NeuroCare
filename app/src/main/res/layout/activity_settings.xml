<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F6"
    android:paddingTop="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- HEADER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEUROCARE"
                android:textColor="#FF795B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="My Profile"
                android:textColor="#29243B"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Manage your personal NeuroCare experience."
                android:textColor="#96919F"
                android:textSize="14sp" />

            <!-- PROFILE CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtProfileInitials"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/bg_profile_circle"
                    android:gravity="center"
                    android:text="NC"
                    android:textColor="#FF795B"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="NeuroCare User"
                    android:textColor="#29243B"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Welcome to NeuroCare"
                    android:textColor="#96919F"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_training_card"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="✦  NeuroCare Member"
                    android:textColor="#FF795B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PERSONAL INFORMATION HEADER -->

            <LinearLayout
                android:id="@+id/headerPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤  Personal Information"
                    android:textColor="#29243B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/arrowPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌄"
                    android:textColor="#FF795B"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PERSONAL CONTENT -->

            <LinearLayout
                android:id="@+id/contentPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textColor="#29243B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Your NeuroCare profile and account information."
                    android:textColor="#96919F"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- APPEARANCE HEADER -->

            <LinearLayout
                android:id="@+id/headerAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎨  Appearance"
                    android:textColor="#29243B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/arrowAppearance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌄"
                    android:textColor="#FF795B"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- APPEARANCE CONTENT -->

            <LinearLayout
                android:id="@+id/contentAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Theme"
                    android:textColor="#29243B"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Choose your favourite colour style."
                    android:textColor="#96919F"
                    android:textSize="13sp" />

                <!-- LIGHT THEME -->

                <LinearLayout
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#FF795B" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:text="Light Theme"
                        android:textColor="#302723"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="#FF795B"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- DARK THEME -->

                <LinearLayout
                    android:id="@+id/themeDark"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#292929" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:text="Dark Theme"
                        android:textColor="#302723"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="#FF795B"
                        android:textSize="23sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- BLUE THEME -->

                <LinearLayout
                    android:id="@+id/themeBlue"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#3478F6" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:text="Blue Theme"
                        android:textColor="#302723"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkBlue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="#FF795B"
                        android:textSize="23sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- PURPLE THEME -->

                <LinearLayout
                    android:id="@+id/themePurple"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#8957D5" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:text="Purple Theme"
                        android:textColor="#302723"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checkPurple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="#FF795B"
                        android:textSize="23sp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- ABOUT HEADER -->

            <LinearLayout
                android:id="@+id/headerAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_white_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🧠  About NeuroCare"
                    android:textColor="#29243B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/arrowAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌄"
                    android:textColor="#FF795B"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ABOUT CONTENT -->

            <LinearLayout
                android:id="@+id/contentAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NeuroCare"
                    android:textColor="#29243B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Brain Training &amp; Cognitive Wellness"
                    android:textColor="#96919F"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Version 1.0"
                    android:textColor="#96919F"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- FOOTER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="NeuroCare • Your Brain, Your Progress"
                android:textColor="#A99D98"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:padding="5dp"
        android:background="@drawable/bg_bottom_navigation">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navGames"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦&#10;Games"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▥&#10;Progress"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◷&#10;History"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected"
            android:text="♙&#10;Profile"
            android:textColor="#9A3412"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>