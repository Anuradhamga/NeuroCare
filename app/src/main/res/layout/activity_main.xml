<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingTop="8dp">

    <!-- Main Scroll Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good morning"
                        android:textColor="#6B5B52"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi, Akitha"
                        android:textColor="#2B1A10"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="AA"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#9A3412"
                    android:background="@drawable/bg_profile_circle" />

            </LinearLayout>


            <!-- DAILY GOAL CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@drawable/bg_daily_goal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAILY GOAL"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/txtDailyGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2 of 3 sessions done"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnContinueTraining"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Continue training"
                        android:textAllCaps="false"
                        android:textColor="#9A3412"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="#FFFFFF" />

                </LinearLayout>

                <!-- Circular Goal -->

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="10dp">

                    <ProgressBar
                        android:id="@+id/dailyGoalProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:max="100"
                        android:progress="67"
                        android:rotation="-90"
                        android:progressDrawable="@drawable/circular_progress"
                        android:background="@drawable/circular_progress_background" />

                    <TextView
                        android:id="@+id/txtGoalPercentage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2/3"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>


            <!-- BRAIN TRAINING -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brain training"
                android:textColor="#2B1A10"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp">

                <!-- Memory Match -->

                <LinearLayout
                    android:id="@+id/cardMemoryMatch"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_training_card">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_circle"
                        android:text="▣"
                        android:textSize="23sp"
                        android:textColor="#C94A0C" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Memory Match"
                        android:textColor="#2B1A10"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Match the pairs"
                        android:textColor="#6B5B52"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- Attention Practice -->

                <LinearLayout
                    android:id="@+id/cardAttention"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_training_card">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_circle"
                        android:text="◎"
                        android:textSize="25sp"
                        android:textColor="#C94A0C" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Attention Practice"
                        android:textColor="#2B1A10"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stay focused"
                        android:textColor="#6B5B52"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- Reaction Time -->

                <LinearLayout
                    android:id="@+id/cardReaction"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_training_card">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_circle"
                        android:text="ϟ"
                        android:textSize="25sp"
                        android:textColor="#C94A0C" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Reaction Time"
                        android:textColor="#2B1A10"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap fast"
                        android:textColor="#6B5B52"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- LAST 7 DAYS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_chart_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Last 7 days"
                        android:textColor="#2B1A10"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAverageScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average score 70"
                        android:textColor="#6B5B52"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Chart Bars -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="115dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:weightSum="7"
                    android:layout_marginTop="12dp">

                    <!-- Tuesday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="58"
                            android:textSize="11sp"
                            android:textColor="#2B1A10" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="46dp"
                            android:background="#EA580C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tue"
                            android:textSize="11sp"
                            android:textColor="#6B5B52" />

                    </LinearLayout>

                    <!-- Wednesday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:text="66"
                            android:textSize="11sp"
                            android:textColor="#2B1A10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="53dp"
                            android:background="#EA580C" />

                        <TextView
                            android:text="Wed"
                            android:textSize="11sp"
                            android:textColor="#6B5B52"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Thursday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:text="62"
                            android:textSize="11sp"
                            android:textColor="#2B1A10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="50dp"
                            android:background="#EA580C" />

                        <TextView
                            android:text="Thu"
                            android:textSize="11sp"
                            android:textColor="#6B5B52"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Friday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:text="74"
                            android:textSize="11sp"
                            android:textColor="#2B1A10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="59dp"
                            android:background="#EA580C" />

                        <TextView
                            android:text="Fri"
                            android:textSize="11sp"
                            android:textColor="#6B5B52"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Saturday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:text="70"
                            android:textSize="11sp"
                            android:textColor="#2B1A10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="56dp"
                            android:background="#EA580C" />

                        <TextView
                            android:text="Sat"
                            android:textSize="11sp"
                            android:textColor="#6B5B52"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Sunday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:text="81"
                            android:textSize="11sp"
                            android:textColor="#2B1A10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="65dp"
                            android:background="#EA580C" />

                        <TextView
                            android:text="Sun"
                            android:textSize="11sp"
                            android:textColor="#6B5B52"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Monday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:text="76"
                            android:textSize="11sp"
                            android:textColor="#2B1A10"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="61dp"
                            android:background="#7C2D12" />

                        <TextView
                            android:text="Mon"
                            android:textSize="11sp"
                            android:textColor="#6B5B52"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- RECENT SESSIONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent sessions"
                    android:textColor="#2B1A10"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textColor="#C94A0C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Session 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/bg_session_card"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="▣"
                    android:textSize="21sp"
                    android:textColor="#C94A0C"
                    android:background="@drawable/bg_icon_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:text="Memory Match"
                        android:textColor="#2B1A10"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="Today"
                        android:textColor="#6B5B52"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:text="76 pts"
                    android:textColor="#C94A0C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>


            <!-- Session 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/bg_session_card"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="ϟ"
                    android:textSize="23sp"
                    android:textColor="#C94A0C"
                    android:background="@drawable/bg_icon_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:text="Reaction Time"
                        android:textColor="#2B1A10"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="Yesterday"
                        android:textColor="#6B5B52"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:text="312 ms"
                    android:textColor="#C94A0C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:padding="5dp"
        android:background="@drawable/bg_bottom_navigation">

        <!-- Home -->
        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected"
            android:text="⌂\nHome"
            android:textColor="#9A3412"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Games -->
        <TextView
            android:id="@+id/navGames"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦\nGames"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Progress -->
        <TextView
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▥\nProgress"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- History -->
        <TextView
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◷\nHistory"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Profile -->
        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="#6B5B52"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>