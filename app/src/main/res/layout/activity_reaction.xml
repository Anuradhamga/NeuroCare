<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reactionMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F6"
    android:padding="22dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEUROCARE"
                android:textColor="#FF795B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reaction Time ⚡"
                android:textColor="#292929"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test how quickly your brain responds."
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Difficulty Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_white_card"
                android:layout_marginTop="22dp"
                android:elevation="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CURRENT CHALLENGE"
                    android:textColor="#89817D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="7dp">

                    <TextView
                        android:id="@+id/txtReactionDifficulty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Medium Level"
                        android:textColor="#FF795B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnChangeReactionDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Change"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_orange_button"
                        android:minWidth="0dp"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtReactionRound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 / 5 Attempts"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <!-- Result Card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="22dp"
                android:layout_marginTop="18dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR REACTION TIME"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtReactionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--- ms"
                    android:textColor="#FF795B"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtReactionMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Press Start to begin!"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Reaction Area -->

            <TextView
                android:id="@+id/txtReactionArea"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_gradient"
                android:gravity="center"
                android:text="READY? 🟠"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:elevation="5dp" />

            <!-- Start Button -->

            <Button
                android:id="@+id/btnStartReaction"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_orange_button"
                android:text="START TEST"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>